{
  "name": "mirainote",
  "private": true,
  "version": "0.1.2",
  "description": "MiraiNote 文档工作台：Markdown、PDF、Word 与 AI 文档助手",
  "author": "XiangZi7",
  "homepage": "https://github.com/XiangZi7/MiraiNote",
  "repository": {
    "type": "git",
    "url": "https://github.com/XiangZi7/MiraiNote.git"
  },
  "bugs": {
    "url": "https://github.com/XiangZi7/MiraiNote/issues"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "version:set": "node scripts/release-version.mjs",
    "version:check": "node scripts/release-version.mjs --check",
    "release": "node scripts/release.mjs",
    "release:build": "tauri build --bundles nsis -- --locked",
    "format": "prettier --write 'src/**/*.{vue,ts,js,jsx,html,css,scss,md}'"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@iconify/vue": "^5.0.1",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@types/node": "^26.4.1",
    "@vueuse/core": "^14.4.0",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.15",
    "idb-keyval": "^6.3.0",
    "mammoth": "^1.12.2",
    "markdown-it": "^15.0.1",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.128",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^8.2.2",
    "vue-tsc": "^2.1.10"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiraiNote",
  "version": "0.1.0",
  "identifier": "com.admin.mirainote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiraiNote",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "XiangZi7",
    "homepage": "https://github.com/XiangZi7/MiraiNote",
    "category": "Productivity",
    "shortDescription": "MiraiNote 文档工作台",
    "longDescription": "支持 Markdown 编辑、PDF 与 Word 阅读、分屏工作区和 AI 文档助手的 Windows 桌面应用。",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "MiraiNote"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
